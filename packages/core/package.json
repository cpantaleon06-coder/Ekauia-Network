{
  "name": "@ecahuil/core",
  "version": "0.0.0",
  "private": true,
  "description": "Claims pipeline, rule authorization and the only adapter that talks to PayPal.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@ecahuil/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "sandbox:order": "pnpm --filter @ecahuil/core... run build && node --env-file=../../.env dist/cli/sandbox-order.js"
  },
  "dependencies": {
    "@ecahuil/contracts": "workspace:*",
    "zod": "^4.6.5"
  }
}
